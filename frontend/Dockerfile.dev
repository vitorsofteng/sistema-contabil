# Frontend Dockerfile - Modo Desenvolvimento
FROM node:20-alpine

WORKDIR /app

# Copia package.json primeiro (cache de dependências)
COPY package*.json ./

# Instala dependências
RUN npm install

# Copia resto do código
COPY . .

# Variável para indicar ambiente Docker
ENV DOCKER=true

# Porta do Vite
EXPOSE 3000

# Roda em modo dev com host 0.0.0.0
CMD ["npm", "run", "dev"]
