# ============================================================================
# SISTEMA CONTÁBIL - VARIÁVEIS DE AMBIENTE
# ============================================================================
# Copie este arquivo para .env e configure os valores
# NUNCA commite o arquivo .env no repositório!
# ============================================================================

# ----------------------------------------------------------------------------
# AMBIENTE
# ----------------------------------------------------------------------------
ENVIRONMENT=development
# Opções: development, staging, production
DEBUG=false

# ----------------------------------------------------------------------------
# APLICAÇÃO
# ----------------------------------------------------------------------------
APP_NAME=Kontabil
APP_VERSION=1.0.0
BASE_URL=http://localhost
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# SEGURANÇA - JWT (OBRIGATÓRIO ALTERAR EM PRODUÇÃO!)
# ----------------------------------------------------------------------------
# Gere com: openssl rand -hex 64
JWT_SECRET=ALTERE_ESTA_CHAVE_EM_PRODUCAO_USE_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# SEGURANÇA - SENHAS
# ----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# SEGURANÇA - RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_REQUESTS_PER_HOUR=5000
RATE_LIMIT_LOGIN_ATTEMPTS=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=5

# ----------------------------------------------------------------------------
# SEGURANÇA - CORS
# ----------------------------------------------------------------------------
# Separar múltiplas origens por vírgula
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# SEGURANÇA - HEADERS
# ----------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ----------------------------------------------------------------------------
# SEGURANÇA - CRIPTOGRAFIA DE DADOS (Sprint 2)
# ----------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
# IMPORTANTE: Se você perder essa chave, dados criptografados serão irrecuperáveis!
ENCRYPTION_KEY=ALTERE_ESTA_CHAVE_EM_PRODUCAO_USE_OPENSSL_RAND_HEX_32

# ----------------------------------------------------------------------------
# SEGURANÇA - 2FA (Sprint 2)
# ----------------------------------------------------------------------------
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER=Sistema Contabil

# ----------------------------------------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://contabil:contabil123@db:5432/contabil
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# REDIS (Cache e Rate Limiting)
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# EMAIL (Recuperação de senha) - Usando Resend
# ----------------------------------------------------------------------------
# Crie conta gratuita em https://resend.com
# 3.000 emails/mês grátis
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=Kontabil <noreply@kontabil.com.br>

# SMTP Legado (opcional, se preferir SMTP tradicional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@seudominio.com
SMTP_FROM_NAME=Kontabil
SMTP_TLS=true

# ----------------------------------------------------------------------------
# STORAGE
# ----------------------------------------------------------------------------
STORAGE_TYPE=local
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------------------------
# LOGS
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# AUDITORIA (Sprint 2)
# ----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# ANTHROPIC API (Importação com IA)
# ----------------------------------------------------------------------------
# Obtenha sua API key em: https://console.anthropic.com/
# Custo aproximado: R$ 0,05 - 0,20 por importação
# 
# ⚠️  IMPORTANTE: NUNCA commite esta chave no Git!
# ⚠️  Se não tiver a chave, a importação usará apenas o parser local (Domínio)
#
ANTHROPIC_API_KEY=
