# ==============================================================================
# AMBIENTE: PRODUÇÃO
# ==============================================================================
# ⚠️  ATENÇÃO: ESTE ARQUIVO CONTÉM CONFIGURAÇÕES SENSÍVEIS!
# ⚠️  NUNCA COMMITAR ESTE ARQUIVO COM SENHAS REAIS!
# ⚠️  USE VARIÁVEIS DE AMBIENTE OU SECRETS MANAGER!

# Identificação do ambiente
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# ==============================================================================
# BANCO DE DADOS
# ==============================================================================
# Recomendação: Use AWS RDS, Google Cloud SQL ou similar
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}?sslmode=require
DB_HOST=seu-banco.rds.amazonaws.com
DB_PORT=5432
DB_NAME=contabil_prod
DB_USER=contabil_prod
DB_PASSWORD=USE_SECRETS_MANAGER

# Pool de conexões
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==============================================================================
# SEGURANÇA
# ==============================================================================
# ⚠️  GERE CHAVES ÚNICAS E FORTES!
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=USE_SECRETS_MANAGER
ENCRYPTION_KEY=USE_SECRETS_MANAGER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ==============================================================================
# API
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://app.contabil.com.br,https://www.contabil.com.br

# ==============================================================================
# RATE LIMITING (mais restritivo em produção)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=10

# ==============================================================================
# FUNCIONALIDADES
# ==============================================================================
ENABLE_2FA=true
ENABLE_AUDIT_LOG=true
ENABLE_ENCRYPTION=true

# ==============================================================================
# EMAIL
# ==============================================================================
SMTP_ENABLED=true
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=USE_SECRETS_MANAGER
SMTP_PASSWORD=USE_SECRETS_MANAGER
SMTP_FROM=noreply@contabil.com.br
SMTP_TLS=true

# ==============================================================================
# REDIS (para cache e sessões)
# ==============================================================================
REDIS_ENABLED=true
REDIS_URL=redis://seu-redis.cache.amazonaws.com:6379/0
REDIS_PASSWORD=USE_SECRETS_MANAGER

# ==============================================================================
# MONITORAMENTO
# ==============================================================================
SENTRY_DSN=USE_SECRETS_MANAGER
ENABLE_METRICS=true
METRICS_PORT=9090

# ==============================================================================
# BACKUP
# ==============================================================================
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=contabil-backups-prod
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# DOCKER
# ==============================================================================
COMPOSE_PROJECT_NAME=contabil_prod
